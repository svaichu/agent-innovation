# Copy to .env (which is gitignored) and fill in ONE provider.
# Existing exported environment variables take precedence over this file.

# --- Anthropic ---------------------------------------------------------
# Needs an API key from https://console.anthropic.com with credits on it.
# A Claude Pro/Max subscription does NOT include API access.
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...

# --- OpenAI ------------------------------------------------------------
# The key the AI Connect organizers were going to provide.
# LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-...

# --- Optional ----------------------------------------------------------
# Override the model. Defaults: claude-opus-5 / gpt-4.1-mini
# COMPASS_MODEL=claude-haiku-4-5
# Thinking depth for Anthropic models: low | medium | high | xhigh | max
# Default is low - these calls are extraction and classification.
# COMPASS_EFFORT=low

# Leave everything commented out to run on the offline rule engine.
