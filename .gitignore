# Secrets and credentials: never commit these.
# TEST_LOGINS.md and demo_logins.csv hold plain-text demo passwords for
# localhost. They are generated by seed/generate_logins.py, so anyone can
# recreate them without them living in git history.
.env.*
!.env.example
*.key
*.pem
TEST_LOGINS.md
seed/data/demo_logins.csv

# Derived data. Rebuild with: python -m seed.load
# Nothing here is an input - raw employee ideas live in knowledge-base/ideas/raw/
compass.db
compass.db-journal
compass.db-wal

